{
  "manifest_version": 3,
  "name": "AntiRedirect",
  "version": "1.2.0",
  "description": "Журнал переходов и блокировка рекламных доменов",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "downloads",
    "declarativeNetRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AntiRedirect"
  }
}